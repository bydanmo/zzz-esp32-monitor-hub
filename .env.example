# Optional: copy to .env. Default is local-only; real host data is collected.
HUB_HOST=127.0.0.1
HUB_PORT=8787
SYSTEM_REFRESH_MS=2000
PROVIDER_TIMEOUT_MS=7000
# For ESP32 access on a trusted LAN, set HUB_HOST=0.0.0.0.
# Optional external sensor service:
# HARDWARE_MONITOR_URL=http://127.0.0.1:8085/data.json
